# Copy to deploy/production.env and fill in. Never commit the real file (.env.* is git-ignored).
SCRIPTLIV_DOMAIN=scriptliv.com
SCRIPTLIV_ENV=production

# Database
MONGODB_URI=
SCRIPTLIV_DB=scriptliv

# Secrets: generate each with  python -c "import secrets; print(secrets.token_urlsafe(48))"
SCRIPTLIV_JWT_SECRET=
SCRIPTLIV_RELAY_SECRET=

# Inaugural offer: free, unlimited minutes for everyone until this date (YYYY-MM-DD, end of that day). Blank = off.
# While on, plan and add-on purchases are paused and no minutes are deducted. Remove the line to end the offer.
# SCRIPTLIV_PROMO_UNLIMITED_UNTIL=2026-11-30

# Public addresses (https only)
SCRIPTLIV_APP_URL=https://scriptliv.com
SCRIPTLIV_CORS_ORIGINS=https://scriptliv.com
SCRIPTLIV_ANDROID_STORE_URL=
SCRIPTLIV_IOS_STORE_URL=

# Payments: Cashfree LIVE keys (not the TEST ones). CASHFREE_LIVE=1 switches to the live API.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_LIVE=1

# Email (verification, password reset, invoices)
RESEND_API_KEY=
RESEND_FROM=ScriptLiv <info@scriptliv.com>
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=

# Must stay unset in production:
#   SCRIPTLIV_DEV_RETURN_TOKENS, SCRIPTLIV_ENABLE_DOCS
